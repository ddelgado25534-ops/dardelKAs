<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/slate_100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Image & SKU Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/ivDetailImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@color/slate_100"
                        android:src="@drawable/ic_placeholder_box"
                        android:contentDescription="@string/cd_logo" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvDetailSku"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="SKU: ELEC-905 • Electronics"
                        android:textColor="@color/amber_700"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:letterSpacing="0.02"
                        android:background="@drawable/bg_stats_badge"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Live Stock Counter Control Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_live_stock_count"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/text_secondary"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMinusOne"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="@string/btn_minus_one"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/crimson_600"
                        android:textColor="@color/white"
                        app:cornerRadius="16dp"
                        app:elevation="3dp" />

                    <TextView
                        android:id="@+id/tvDetailQuantity"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        tools:text="48"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@color/slate_900"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlusOne"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="@string/btn_plus_one"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/emerald_600"
                        android:textColor="@color/white"
                        app:cornerRadius="16dp"
                        app:elevation="3dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Product Configuration Form Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_product_configuration"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="14dp" />

                <!-- Product Name Edit -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_product_name"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/etDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/hint_product_name"
                    tools:text="Industrial Power Drill 20V"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/slate_400"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="14dp"
                    android:layout_marginTop="6dp"
                    android:inputType="textCapWords"
                    android:importantForAutofill="no" />

                <!-- Price Edit -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_unit_price"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="14dp" />

                <EditText
                    android:id="@+id/etDetailPrice"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/hint_unit_price"
                    tools:text="149.99"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/slate_400"
                    android:inputType="numberDecimal"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="14dp"
                    android:layout_marginTop="6dp"
                    android:importantForAutofill="no" />

                <!-- Alert Threshold Edit -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_min_threshold"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginTop="14dp" />

                <EditText
                    android:id="@+id/etDetailMinThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/label_min_threshold"
                    tools:text="10"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/slate_400"
                    android:inputType="number"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="14dp"
                    android:layout_marginTop="6dp"
                    android:importantForAutofill="no" />

                <!-- Save Changes Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveChanges"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="@string/btn_save_changes"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:backgroundTint="@color/slate_900"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_save"
                    app:iconTint="@color/white"
                    app:cornerRadius="12dp"
                    app:elevation="4dp"
                    android:layout_marginTop="24dp" />

                <!-- Delete Product Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteProduct"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="@string/btn_delete_product"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/crimson_600"
                    app:strokeColor="@color/crimson_600"
                    app:strokeWidth="1.5dp"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/crimson_600"
                    app:cornerRadius="12dp"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
