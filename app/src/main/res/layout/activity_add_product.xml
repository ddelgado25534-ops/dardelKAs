<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/slate_100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/slate_900"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_product_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_product_subtitle"
                    android:textSize="13sp"
                    android:textColor="@color/amber_500"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Product Image Picker Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#CBD5E1">

                    <ImageView
                        android:id="@+id/ivPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@color/slate_100"
                        android:src="@drawable/ic_placeholder_box"
                        android:contentDescription="@string/cd_logo" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCamera"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/btn_take_photo"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:backgroundTint="@color/slate_900"
                        android:textColor="@color/white"
                        app:icon="@drawable/ic_camera"
                        app:iconTint="@color/white"
                        app:cornerRadius="10dp"
                        android:layout_marginEnd="6dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGallery"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/btn_choose_gallery"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/slate_900"
                        app:strokeColor="@color/slate_900"
                        app:icon="@drawable/ic_gallery"
                        app:iconTint="@color/slate_900"
                        app:cornerRadius="10dp"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Product Details Form Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Category Spinner -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_category"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="8dp"
                    android:layout_marginTop="6dp">

                    <Spinner
                        android:id="@+id/spinnerCategory"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical" />
                </FrameLayout>

                <!-- SKU Code -->
                <EditText
                    android:id="@+id/etSku"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/hint_sku"
                    android:textColorHint="@color/slate_400"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="14dp"
                    android:layout_marginTop="14dp"
                    android:inputType="textCapCharacters"
                    android:importantForAutofill="no" />

                <!-- Product Name -->
                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/hint_product_name"
                    android:textColorHint="@color/slate_400"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="14dp"
                    android:layout_marginTop="12dp"
                    android:inputType="textCapWords"
                    android:importantForAutofill="no" />

                <!-- Description -->
                <EditText
                    android:id="@+id/etDescription"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:hint="@string/hint_description"
                    android:textColorHint="@color/slate_400"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:gravity="top|start"
                    android:background="@drawable/bg_input_field"
                    android:padding="14dp"
                    android:layout_marginTop="12dp"
                    android:inputType="textMultiLine"
                    android:importantForAutofill="no" />

                <!-- Price & Quantity Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <EditText
                        android:id="@+id/etPrice"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_unit_price"
                        android:textColorHint="@color/slate_400"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:inputType="numberDecimal"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="14dp"
                        android:importantForAutofill="no"
                        android:layout_marginEnd="6dp"/>

                    <EditText
                        android:id="@+id/etQuantity"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:hint="@string/hint_initial_qty"
                        android:textColorHint="@color/slate_400"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:inputType="number"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="14dp"
                        android:importantForAutofill="no"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>

                <!-- Min Threshold -->
                <EditText
                    android:id="@+id/etMinThreshold"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/hint_min_threshold"
                    android:textColorHint="@color/slate_400"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:inputType="number"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="14dp"
                    android:layout_marginTop="12dp"
                    android:importantForAutofill="no" />

                <!-- Submit Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitProduct"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_upload_product"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:backgroundTint="@color/amber_500"
                    android:textColor="@color/slate_900"
                    app:cornerRadius="12dp"
                    app:elevation="4dp"
                    android:layout_marginTop="24dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
